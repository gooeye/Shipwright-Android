<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/pad_pressed_fill" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFFFFFFF" />
                    <size
                        android:width="25dp"
                        android:height="25dp" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/pad_fill" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/pad_stroke" />
                    <size
                        android:width="25dp"
                        android:height="25dp" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
