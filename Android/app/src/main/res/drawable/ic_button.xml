<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/pad_pressed_fill" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pad_fill" />
            <stroke android:width="1.5dp" android:color="@color/pad_stroke" />
        </shape>
    </item>
</selector>
