<?xml version="1.0" encoding="utf-8"?>
<!-- Invisible hit area over the C-button cross; lights up while held. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/pad_c_pressed" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
