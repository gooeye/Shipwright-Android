<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/pad_a_pressed" />
            <stroke android:width="1.5dp" android:color="#FFB9CEFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/pad_a_fill" />
            <stroke android:width="1.5dp" android:color="#998FB0FF" />
        </shape>
    </item>
</selector>
