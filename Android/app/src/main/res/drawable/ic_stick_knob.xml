<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:startColor="#F2FFFFFF"
                android:endColor="#B3D7DEE8" />
            <stroke android:width="2dp" android:color="@color/setup_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:startColor="#B3FFFFFF"
                android:endColor="#668A94A3" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</selector>
