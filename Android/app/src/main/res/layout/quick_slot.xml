<?xml version="1.0" encoding="utf-8"?>
<!-- One save state slot in the pause menu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/quick_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/slot_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/setup_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/slot_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/setup_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
