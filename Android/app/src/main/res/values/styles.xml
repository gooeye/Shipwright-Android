<resources>

    <!-- Fullscreen game theme. Material (not Holo) so system dialogs and the file picker
         hand-off look current. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Rounded dialog used for in-game prompts (ROM selection, errors). -->
    <style name="SohDialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorAccent">@color/setup_accent</item>
    </style>

    <style name="SetupTitle">
        <item name="android:textColor">@color/setup_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="SetupBody">
        <item name="android:textColor">@color/setup_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="SetupButton">
        <item name="android:background">@drawable/setup_button_primary</item>
        <item name="android:textColor">@color/setup_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SetupButton.Text">
        <item name="android:background">@drawable/setup_button_text</item>
        <item name="android:textColor">@color/setup_accent</item>
    </style>

    <!-- On-screen controller buttons: no Material shadow/elevation, readable labels. -->
    <style name="PadButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pad_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:hapticFeedbackEnabled">true</item>
    </style>

    <style name="PadButton.Small">
        <item name="android:textSize">12sp</item>
    </style>

</resources>
